{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/feedback/:id",
      "destination": "/api/feedback/:id"
    },
    {
      "source": "/((?!api($|/)).*)",
      "destination": "/index.html"
    }
  ]
}
